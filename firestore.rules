rules_version = '2';

// PaperVault Firestore security rules.
// Source of truth: DETAILED_PLAN.md §8.4
//
// Golden rule: PADHNA (read/download) = BINA LOGIN.
//              DALNA (write) = LOGIN zaroori, role ke hisab se.
//
// Roles live in users/{uid}.role: "admin" | "moderator" | "user"
// First admin is promoted manually from the Firebase console (§9).
//
// Security hardening (audit 2026-10-10):
//  - users: create rule added (new logins were denied before); role locked
//    to 'user' on create; admin can list users.
//  - uploads: create locked to status pending/ai_approved.
//  - requests: updates are upvote-only (self-add to requestedBy).
//  - chat: create binds uid to sender, 1000-char cap; delete = own or mod.
//  - reports: create binds reportedBy to sender, details capped.
//  - papers: public can only bump downloads/views counters.

service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isMod() {
      return request.auth != null &&
        get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderator'];
    }

    // Papers: public read, mod/admin write.
    // Public can increment downloads/views counters (for stats).
    // NOTE: pending/rejected papers are readable by anyone (M1 accepted risk —
    // scoping read to status=='approved' would need a composite index for the
    // subject listing query; fileUrls are public-by-design Cloudinary URLs).
    match /papers/{id} {
      allow read: if true;
      allow create, delete: if isMod();
      allow update: if isMod() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads', 'views'])
      );
    }

    // Notes: public read, admin-only write.
    match /notes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Syllabus: public read, admin-only write.
    match /syllabus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subjects: public read, admin-only write (DB-driven taxonomy).
    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Upload history: user sees own; mods see all; create = logged-in owner
    // with status locked (no self-approve).
    match /uploads/{id} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isMod());
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['pending', 'ai_approved'];
      allow update: if isMod();
    }

    // Users: self read; admins can list; anyone can create ONLY their own doc
    // with role locked to 'user' (no self-promote); role changes admin-only.
    match /users/{uid} {
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'email', 'photo', 'role', 'uploadCount', 'createdAt']);
      allow update: if isAdmin();
    }

    // Chat: public read; logged-in create bound to sender, 1000-char cap;
    // delete = own message or mod.
    match /chatRooms/{room}/messages/{msg} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'photo', 'text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 1000;
      allow delete: if isMod()
        || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // Paper requests: public read; logged-in create; updates are upvote-only
    // (caller can only add THEMSELVES to requestedBy).
    match /requests/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isMod() || (request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requestedBy'])
        && request.auth.uid in request.resource.data.requestedBy
        && !(request.auth.uid in resource.data.requestedBy));
    }

    // Reports: logged-in users file them (bound to sender, details capped);
    // mods read them.
    match /reports/{id} {
      allow read: if isMod();
      allow create: if request.auth != null
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.details is string
        && request.resource.data.details.size() < 1000;
    }

    // Exam countdown settings: public read, admin-only write.
    match /settings/examCountdown {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Moderation mode settings: public read, admin-only write.
    match /settings/moderation {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
